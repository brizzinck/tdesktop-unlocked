+++ b/Telegram/SourceFiles/history/history_item.cpp
@@ -2905,15 +2905,10 @@ bool HistoryItem::canStopPoll() const {
 }
 
 bool HistoryItem::forbidsForward() const {
-	return (_flags & MessageFlag::NoForwards);
